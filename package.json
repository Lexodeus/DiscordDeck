{
  "name": "discord-deck",
  "version": "0.1.3",
  "description": "Opens Vesktop (Vencord) or Discord from the Steam menu in Gaming Mode, without adding it as a non-Steam game",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lexodeus/DiscordDeck.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "discord",
    "vesktop",
    "vencord"
  ],
  "author": "Lexodeus",
  "license": "GPL-3.0",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
